{
  "openapi": "3.0.3",
  "info": {
    "title": "auth",
    "version": "3.8.0",
    "description": "Reusable identity and credential domain: accounts, passwords, JWTs, single-session enforcement, email ownership verification, password recovery, passwordless login links, and transactional email delivery. Distributed as a binary only; see docs/api.md for the human-readable reference."
  },
  "servers": [
    { "url": "/api" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "tags": [
    { "name": "auth" },
    { "name": "users" },
    { "name": "health" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["UP"] } }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Sign in by username or email. Rejected with 409 while the account already has an active session (single active session per account).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "description": "Username or email address" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthResponse" },
          "400": { "$ref": "#/components/responses/ValidationOrInvalidArgument" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Create an account and issue a session JWT, then send a verification link (when EMAIL_VERIFICATION_REQUIRED)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password", "name"],
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "name": { "type": "string" },
                  "role": { "type": "string", "default": "member" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/AuthResponse" },
          "400": { "$ref": "#/components/responses/ValidationOrInvalidArgument" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/register-with-profile": {
      "post": {
        "tags": ["auth"],
        "summary": "Register from email only; username derived from the email local-part",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/AuthResponse" },
          "400": { "$ref": "#/components/responses/ValidationOrInvalidArgument" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/verify-email": {
      "get": {
        "tags": ["auth"],
        "summary": "Consume a one-time email verification link",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Format <recordId>.<secret>"
          }
        ],
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verified": { "type": "boolean", "enum": [true] },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidArgument" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": ["auth"],
        "summary": "Send a new verification link for the authenticated user",
        "responses": {
          "202": {
            "description": "Accepted by Brevo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean", "enum": [true] },
                    "messageId": { "type": "string", "nullable": true },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/mail": {
      "post": {
        "tags": ["auth"],
        "summary": "Deliver fully-rendered transactional emails on behalf of other domains",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["recipient_id", "subject", "html"],
                      "properties": {
                        "recipient_id": { "type": "string", "description": "Auth user id (resolved to email)" },
                        "subject": { "type": "string" },
                        "html": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-message delivery counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "integer" },
                    "skipped": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/Internal" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/change-password": {
      "put": {
        "tags": ["auth"],
        "summary": "Change the authenticated user's password (query params, not a JSON body)",
        "parameters": [
          { "name": "currentPassword", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "newPassword", "in": "query", "required": true, "schema": { "type": "string", "minLength": 8 } }
        ],
        "responses": {
          "204": { "description": "Password updated" },
          "400": { "$ref": "#/components/responses/ValidationOrInvalidArgument" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/verify-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Verify the authenticated user's password for sensitive-action confirmations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": { "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validity of the password",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "valid": { "type": "boolean" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Start password recovery. Always returns 202 so it cannot be used to enumerate accounts.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Always accepted (mail sent only when the account exists and delivery is configured)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean", "enum": [true] },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Complete password recovery with the one-time email token. Revokes every active session.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "newPassword"],
                "properties": {
                  "token": { "type": "string", "description": "<recordId>.<secret>" },
                  "newPassword": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Password updated and all sessions revoked" },
          "400": { "$ref": "#/components/responses/InvalidArgument" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/login-link": {
      "post": {
        "tags": ["auth"],
        "summary": "Request a passwordless login link — the recovery path for a user locked out of the single active session. Always returns 202 so it cannot be used to enumerate accounts.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Always accepted (mail sent only when the account exists and delivery is configured)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean", "enum": [true] },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/login-link/confirm": {
      "post": {
        "tags": ["auth"],
        "summary": "Complete a passwordless sign-in with the one-time email token. Mints a fresh session and revokes every older one; also marks an unverified account's email as verified (mailbox proof).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": { "token": { "type": "string", "description": "<recordId>.<secret>" } }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthResponse" },
          "400": { "$ref": "#/components/responses/InvalidArgument" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/me": {
      "put": {
        "tags": ["auth"],
        "summary": "Update the authenticated user's name",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/verification-status": {
      "get": {
        "tags": ["auth"],
        "summary": "Email-verification state for the authenticated user (always true when verification is not required)",
        "responses": {
          "200": {
            "description": "Verification state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "emailVerified": { "type": "boolean" },
                    "verificationExpiresInSeconds": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/access-rights": {
      "get": {
        "tags": ["auth"],
        "summary": "Access-right tokens (permissions) held by the authenticated user",
        "responses": {
          "200": {
            "description": "Permission tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "emailVerified": { "type": "boolean" },
                    "permissions": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["auth"],
        "summary": "Authenticated identity for sibling domains",
        "responses": {
          "200": {
            "description": "The authenticated user",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/session-status": {
      "get": {
        "tags": ["auth"],
        "summary": "Single-session status for the presented token. A revoked or expired session returns 401, so callers only distinguish 200 vs not-200.",
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": { "type": "string" },
                    "active": { "type": "boolean" },
                    "expiresInSeconds": { "type": "integer" },
                    "userId": { "type": "string" },
                    "username": { "type": "string" },
                    "role": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Revoke the caller's current session",
        "responses": {
          "204": { "description": "Session revoked" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/users/check-existence": {
      "post": {
        "tags": ["auth"],
        "summary": "Return which usernames already exist",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["usernames"],
                "properties": {
                  "usernames": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing usernames",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "existing": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/auth/users/{id}": {
      "get": {
        "tags": ["auth"],
        "summary": "Public identity lookup by user id",
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/users/username/{username}": {
      "get": {
        "tags": ["auth"],
        "summary": "Public identity lookup by username",
        "security": [],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/users/email/{email}": {
      "get": {
        "tags": ["auth"],
        "summary": "Public identity lookup by email",
        "security": [],
        "parameters": [
          { "name": "email", "in": "path", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": {
            "description": "User identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}": {
      "delete": {
        "tags": ["users"],
        "summary": "Soft-deactivate a user account (OWNER role only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Account deactivated" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/admin/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Provision accounts as an active superadmin (outside the public credential rate limiter). Never expose as a public gateway route.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password", "name"],
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "name": { "type": "string" },
                  "role": { "type": "string", "default": "member" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/AuthResponse" },
          "400": { "$ref": "#/components/responses/ValidationOrInvalidArgument" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/admin/users/{id}/roles": {
      "put": {
        "tags": ["auth"],
        "summary": "Replace a user's roles as an active superadmin. Revokes the target's sessions so new claims match.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["roles"],
                "properties": {
                  "roles": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidArgument" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/auth/admin/users/{id}/roles/add": {
      "put": {
        "tags": ["auth"],
        "summary": "Add roles to a user as an active superadmin. Revokes the target's sessions so new claims match.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["roles"],
                "properties": {
                  "roles": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserDto" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidArgument" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "MongoDB ObjectId hex" },
          "name": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "emailVerified": { "type": "boolean" },
          "role": { "type": "string", "description": "Primary role (legacy single-role consumers)" },
          "roles": { "type": "array", "items": { "type": "string" }, "description": "Complete effective role set" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "HS512-signed JWT" },
          "user": { "$ref": "#/components/schemas/UserDto" },
          "expiresIn": { "type": "integer", "description": "Token lifetime in seconds" },
          "sessionId": { "type": "string", "description": "The single active session id bound to this token (also the JWT sid claim)" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "nullable": true },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": { "type": "string" }, "nullable": true },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "enum": ["Unauthorized"] },
          "message": { "type": "string" }
        }
      },
      "RateLimitedResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "enum": ["Too many attempts. Please wait a moment and try again."] }
        }
      }
    },
    "responses": {
      "AuthResponse": {
        "description": "JWT plus the credential-domain user",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
        }
      },
      "Validation": {
        "description": "Blank required fields or weak password",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "InvalidArgument": {
        "description": "Bad credentials, invalid/expired verification/reset/login-link token, unconfigured mail",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ValidationOrInvalidArgument": {
        "description": "Validation or invalid-argument failure",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or expired bearer token (also: revoked or superseded single session)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/UnauthorizedResponse" } }
        }
      },
      "Forbidden": {
        "description": "Valid token but role not permitted",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "User not found (including malformed ObjectIds)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Conflict": {
        "description": "Username or email already registered, or login while the account already has an active session",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Internal": {
        "description": "Unexpected failure",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "RateLimited": {
        "description": "Per-source-IP token bucket exhausted",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/RateLimitedResponse" } }
        }
      }
    }
  }
}
