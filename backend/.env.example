# MongoDB — Eco assigns a project-scoped local database on every `eco up`.
# Do not hard-code an estate database name here.
ECO_MANAGED_MONGODB_URI=true
MONGODB_URI=

# JWT (must match the shared secret used by lms-backend)
# Required -- the service refuses to start without a real secret at least
# 32 bytes long (64+ recommended for HS512). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=2592000000

# Server
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080/api

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Object storage: "local" (default, writes to STORAGE_LOCAL_PATH) or "s3"
# (MinIO/S3-compatible -- run `eco install minio`, then set ecompose.yml's
# storage.minio.endpoint; 'eco configure' fills S3_* below automatically).
# The only files auth still owns are avatar/cover-photo uploads.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=auth
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Rate limiting (per-source-IP token bucket)
# General routes: burst capacity, then 1 token/RATE_LIMIT_GENERAL_REPLENISH_SECS refill
RATE_LIMIT_GENERAL_BURST=120
RATE_LIMIT_GENERAL_REPLENISH_SECS=1
# Login/register/change-password: much tighter, blunts brute force / credential stuffing
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_AUTH_REPLENISH_SECS=10

# Email verification — accounts may use private features before verification,
# but estates can require it for public interactions such as marketplace/chat.
# Currently disabled because no Brevo sending key is configured; set it to true
# (and fill BREVO_API_KEY / MAIL_FROM_EMAIL) before public rollout.
# Eco copies new keys from this file into .env during `eco up`; set secrets in
# the generated .env only. Brevo's free transactional tier uses this API key.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@stuff8.com
MAIL_FROM_NAME=Stuff8
# `eco serve` injects these short-lived values for its password-recovery
# relay when no estate-owned Brevo credentials are present. Never copy a
# platform relay token into source control or a permanent production .env.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
# Public origin for links opened by people, such as email verification.
# Optional: Eco uses the first CORS_ALLOWED_ORIGINS value when this is empty.
# Set explicitly only when the public application origin differs from CORS.
EMAIL_VERIFICATION_PUBLIC_URL=
# Legacy fallback for older deployments; use EMAIL_VERIFICATION_PUBLIC_URL instead.
AUTH_PUBLIC_URL=

# Single active session per account (default true). A token without an active
# session is rejected 401; every client must re-login once after upgrade. Set
# false only for a graceful legacy-token window (legacy tokens can't be revoked).
SESSION_REQUIRED=true
