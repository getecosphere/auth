pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# Gradle (if used)
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties
gradle/

# IDE files
.idea/
.vscode/
*.iws
*.iml
*.ipr
.settings/
.project
.classpath
bin/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

