logs/
*.log
log/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Environment files
.env*
!.env*.example
!.env*.template

# Runtime
*.pid
*.pid.lock

